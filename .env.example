# Copy to .env and fill in. Never commit the filled file.
# systemd: EnvironmentFile=/opt/ai-monitor/.env

# Slack incoming webhook for #自媒体. The webhook itself picks the channel.
SLACK_WEBHOOK_URL=

# Optional. Public Hugging Face orgs work without a token.
HF_TOKEN=

# First-party list-models. A provider is skipped when its variable is empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional. The public OpenRouter catalog and RSS work without a key.
OPENROUTER_API_KEY=

# Later slices. Unused by the MVP scanners.
ARK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
